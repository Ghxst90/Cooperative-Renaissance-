# Copier ce fichier en .env et remplir les valeurs.
PORT=3000
# Mot de passe de l'espace de gestion (/admin). Sans lui, /admin est désactivé.
ADMIN_PASSWORD=choisir-un-mot-de-passe-solide
# Nombre de membres existants avant le site (affiché dans « Impact »).
BASE_MEMBRES=120
# Dossier où est stockée la base de données.
# DATA_DIR=./data
